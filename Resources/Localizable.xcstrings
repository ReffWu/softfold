    "The desktop renderer is missing. Rebuild the app." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مكوّن عرض سطح المكتب مفقود. أعد بناء التطبيق."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Schreibtisch-Renderer fehlt. Erstelle die App neu."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Falta el renderizador del escritorio. Vuelve a compilar la app."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le moteur de rendu du bureau est introuvable. Recompilez l’app."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il renderer della scrivania non è presente. Ricompila l’app."
