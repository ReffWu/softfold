          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Gem den lågvinkel, du kigger på lige nu"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tallenna kannen kulma, jota katsot juuri nyt"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
