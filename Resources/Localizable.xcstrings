    "Blur builds toward the top and fades out near the hinge." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يزداد التمويه نحو الأعلى ويتلاشى قرب المفصل."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Unschärfe nimmt nach oben zu und verschwindet am Scharnier."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El desenfoque aumenta hacia arriba y desaparece cerca de la bisagra."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le flou s’intensifie vers le haut et disparaît près de la charnière."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La sfocatura aumenta verso l’alto e svanisce vicino alla cerniera."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "上に行くほど強くぼかし、ヒンジ付近では消えていきます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "위쪽으로 갈수록 흐려지고 힌지 근처에서는 사라집니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De vervaging neemt naar boven toe en verdwijnt bij het scharnier."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rozmycie narasta ku górze i znika przy zawiasie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O desfoque aumenta em direção ao topo e some perto da dobradiça."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Размытие усиливается кверху и исчезает у шарнира."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bulanıklık yukarı doğru artar ve menteşeye yakın yerde kaybolur."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Độ mờ tăng dần lên phía trên và biến mất gần bản lề."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "模糊集中在顶部，靠近转轴处逐渐消失。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "模糊集中在頂端，靠近轉軸處逐漸消失。"
          }
        }
      }
    },
    "Blur by distance" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
