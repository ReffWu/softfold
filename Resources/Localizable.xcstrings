    "Your desktop bends as the lid closes.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ينحني سطح المكتب عند إغلاق الغطاء."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Schreibtisch biegt sich beim Zuklappen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu escritorio se dobla al cerrar la tapa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre bureau se plie quand vous rabattez l’écran."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La scrivania si piega quando chiudi lo schermo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ふたを閉じるとデスクトップが折れ曲がります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "덮개를 닫으면 데스크탑이 휘어집니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je bureaublad buigt mee als de klep dichtgaat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Biurko wygina się, gdy zamykasz pokrywę."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua mesa se dobra quando a tampa fecha."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Рабочий стол изгибается, когда вы закрываете крышку."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapak kapanırken masaüstünüz bükülür."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Màn hình nền uốn cong khi bạn gập nắp."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "合上屏幕时桌面会随之弯折。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "闔上螢幕時桌面會隨之彎折。"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ditt skrivbord böjs när locket stängs."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Skrivebordet ditt bøyes når lokket lukkes."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit skrivebord bøjes, når låget lukkes."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Työpöytäsi taittuu, kun kansi sulkeutuu."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш робочий стіл згинається, коли кришка закривається."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Plocha se při zavírání víka sklápí."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ecranul se pliază când închideți capacul."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az íróasztal meghajlik a fedél lecsukásakor."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το γραφείο εργασίας σας διπλώνει καθώς κλείνει το καπάκι."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लिड बंद होने पर आपका डेस्कटॉप झुक जाता है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "লিড বন্ধ করার সময় আপনার ডেস্কটপ ভাঁজ হয়ে যায়।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "மூடி மூடப்படும்போது உங்கள் டெஸ்க்டாப் மடிகிறது."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "لِڈ بند ہونے پر آپ کا ڈیسک ٹاپ مڑ جاتا ہے۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "با بستن صفحه، میزکار شما خمیده می‌شود."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שולחן העבודה שלך מתכופף כשהמכסה נסגר."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เดสก์ท็อปของคุณจะโค้งงอตามการพับฝาลง"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Desktop Anda melipat saat layar ditutup."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Desktop anda melipat apabila penutup ditutup."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Nababali ang iyong desktop habang sumasara ang takip."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Dawati lako linajikunja mfuniko unapofungwa."
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Jou werkskerm buig soos die deksel toemaak."
          }
        },
        "la": {
          "stringUnit": {
            "state": "translated",
            "value": "Scrinium tuum flectitur dum coopertorium clauditur."
          }
        },
        "eo": {
          "stringUnit": {
            "state": "translated",
            "value": "Via labortablo fleksas dum la kovrilo fermiĝas."
          }
        }
      }
    },
