    "Open the lid to your comfortable viewing position first.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح الغطاء أولًا إلى زاوية المشاهدة المريحة لك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne den Deckel zuerst auf deinen bevorzugten Blickwinkel."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Primero abre la tapa hasta tu ángulo de visión cómodo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez d’abord l’écran à votre angle de vue préféré."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri prima lo schermo all’angolazione di visione che preferisci."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "先に、見やすい角度までふたを開いてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "먼저 편하게 보는 각도로 덮개를 여십시오."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Open de klep eerst tot je favoriete kijkhoek."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Najpierw otwórz pokrywę pod wygodnym kątem patrzenia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Primeiro abra a tampa no ângulo de visão que for confortável para você."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сначала откройте крышку до удобного угла обзора."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önce kapağı rahat görüş açınıza kadar açın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy mở nắp đến góc nhìn thoải mái của bạn trước."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先把屏幕打开到你习惯的观看角度。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請先把螢幕打開到你習慣的觀看角度。"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Öppna locket till din bekväma visningsposition först."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Åpne lokket til din behagelige synsvinkel først."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Åbn låget til din behagelige synsvinkel først."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Avaa kansi ensin mukavaan katselukulmaan."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Спочатку відкрийте кришку на зручний кут огляду."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nejprve otevřete víko do pohodlného pozorovacího úhlu."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Deschideți mai întâi capacul în poziția confortabilă de vizionare."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Először nyisd ki a fedelet a kényelmes betekintési szögbe."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ανοίξτε πρώτα το καπάκι στην άνετη γωνία θέασης."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पहले लिड को अपने आरामदायक देखने की स्थिति में खोलें।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্রথমে আপনার সুবিধাজনক দেখার অবস্থানে লিডটি খুলুন।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "முதலில் மூடியை உங்களுக்கு வசதியான பார்வை நிலைக்குத் திறக்கவும்."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "پہلے لِڈ کو اپنے آرام دہ دیکھنے کی پوزیشن پر کھولیں۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "ابتدا صفحه را در موقعیت زاویه دید راحت خود باز کنید."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פתח תחילה את המכסה לזווית הצפייה הנוחה שלך."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โปรดเปิดฝาพับไปยังมุมมองที่คุณถนัดก่อน"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Buka layar ke sudut pandang yang nyaman terlebih dahulu."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Buka penutup pada kedudukan tontonan yang selesa terlebih dahulu."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Buksan muna ang takip sa iyong komportableng posisyon sa panonood."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Fungua mfuniko kwenye nafasi yako nzuri ya kutazama kwanza."
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Maak eers die deksel oop na jou gemaklike kykposisie."
          }
        },
        "la": {
          "stringUnit": {
            "state": "translated",
            "value": "Primum coopertorium ad angulum aptum aperi."
          }
        },
        "eo": {
          "stringUnit": {
            "state": "translated",
            "value": "Unue malfermu la kovrilon al via komforta rigardangulo."
          }
        }
      }
    },
