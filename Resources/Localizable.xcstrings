    "Open Softfold again to come back here.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح Softfold مرة أخرى للعودة إلى هنا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne Softfold erneut, um hierher zurückzukehren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre Softfold de nuevo para volver aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez à nouveau Softfold pour revenir ici."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri di nuovo Softfold per tornare qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Softfoldをもう一度開くと、ここに戻れます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Softfold를 다시 열면 여기로 돌아올 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Softfold opnieuw om hier terug te komen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otwórz ponownie Softfold, aby tu wrócić."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra o Softfold novamente para voltar aqui."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Откройте Softfold снова, чтобы вернуться сюда."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Buraya dönmek için Softfold’u yeniden açın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mở lại Softfold để quay về đây."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "再次打开 Softfold 即可回到这里。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "再次打開 Softfold 即可回到這裡。"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Öppna Softfold igen för att komma tillbaka hit."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Åpne Softfold igjen for å komme tilbake hit."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Åbn Softfold igen for at vende tilbage hertil."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Avaa Softfold uudelleen palataksesi tänne."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкрийте Softfold знову, щоб повернутися сюди."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Chcete-li se sem vrátit, otevřete Softfold znovu."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Deschideți din nou Softfold pentru a reveni aici."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyisd meg újra a Softfoldot az ide való visszatéréshez."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ανοίξτε ξανά το Softfold για να επιστρέψετε εδώ."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यहां वापस आने के लिए Softfold को फिर से खोलें।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এখানে ফিরে আসতে আবার Softfold খুলুন।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இங்கு மீண்டும் வர Softfold-ஐ மீண்டும் திறக்கவும்."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہاں واپس آنے کے لیے Softfold کو دوبارہ کھولیں۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برای بازگشت به اینجا، Softfold را دوباره باز کنید."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פתח שוב את Softfold כדי לחזור לכאן."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิด Softfold อีกครั้งเพื่อกลับมาที่นี่"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Buka Softfold lagi untuk kembali ke sini."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Buka Softfold sekali lagi untuk kembali ke sini."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Buksan muli ang Softfold upang bumalik dito."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Fungua tena Softfold ili kurudi hapa."
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Maak Softfold weer oop om hierheen terug te keer."
          }
        },
        "la": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperi iterum Softfold ut huc redeas."
          }
        },
        "eo": {
          "stringUnit": {
            "state": "translated",
            "value": "Malfermu Softfold denove por reveni ĉi tien."
          }
        }
      }
    },
    "Pause partway and the desktop comes back into focus.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "توقّف في منتصف الطريق وسيعود سطح المكتب واضحًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halte auf halbem Weg an, und der Schreibtisch wird wieder scharf."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Detente a medio camino y el escritorio vuelve a enfocarse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrêtez-vous en chemin et le bureau redevient net."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fermati a metà e la scrivania torna a fuoco."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "途中で止めると、デスクトップのピントが戻ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "중간에 멈추면 데스크탑이 다시 선명해집니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop halverwege en het bureaublad wordt weer scherp."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatrzymaj się w połowie, a biurko znów będzie ostre."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pare no meio do caminho e a mesa volta a ficar nítida."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Остановитесь на полпути, и рабочий стол снова станет резким."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yarı yolda durun, masaüstü yeniden netleşir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dừng giữa chừng và màn hình nền sẽ rõ nét trở lại."
          }
        },
        "zh-Hans": {
