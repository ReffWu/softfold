    "No desktop frames arrived. Check Screen Recording permission and reopen Softfold." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم تصل إطارات سطح المكتب. تحقق من إذن تسجيل الشاشة وأعد فتح Softfold."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es kamen keine Schreibtischbilder an. Prüfe die Berechtigung für Bildschirmaufnahme und öffne Softfold erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No llegaron imágenes del escritorio. Revisa el permiso de Grabación de pantalla y vuelve a abrir Softfold."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucune image du bureau n’est arrivée. Vérifiez l’autorisation d’enregistrement de l’écran et rouvrez Softfold."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non sono arrivati fotogrammi della scrivania. Controlla il permesso di Registrazione schermo e riapri Softfold."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "デスクトップの画像が届きませんでした。画面収録の許可を確認して、Softfoldを開き直してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "데스크탑 프레임이 도착하지 않았습니다. 화면 기록 권한을 확인하고 Softfold를 다시 여십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er kwamen geen beelden van het bureaublad binnen. Controleer de toestemming voor schermopname en open Softfold opnieuw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie dotarły żadne klatki biurka. Sprawdź uprawnienie do nagrywania ekranu i otwórz Softfold ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nenhum quadro da mesa chegou. Verifique a permissão de Gravação de Tela e reabra o Softfold."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кадры рабочего стола не поступили. Проверьте разрешение на запись экрана и снова откройте Softfold."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Masaüstü karesi gelmedi. Ekran Kaydı iznini kontrol edin ve Softfold’i yeniden açın."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không nhận được khung hình màn hình nền. Hãy kiểm tra quyền Ghi màn hình và mở lại Softfold."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "没有收到桌面画面。请检查屏幕录制权限并重新打开 Softfold。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "沒有收到桌面畫面。請檢查螢幕錄製權限並重新開啟 Softfold。"
