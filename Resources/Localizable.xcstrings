    "The lid sensor stopped responding. Softfold turns back on as soon as it reconnects.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "توقف مستشعر الغطاء عن الاستجابة. سيعود Softfold للعمل فور إعادة الاتصال."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Deckelsensor reagiert nicht mehr. Softfold schaltet sich wieder ein, sobald er wieder verbunden ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El sensor de la tapa dejó de responder. Softfold se volverá a activar en cuanto se reconecte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le capteur d’angle ne répond plus. Softfold se réactivera dès qu’il sera reconnecté."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il sensore dello schermo ha smesso di rispondere. Softfold si riattiverà appena si ricollega."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ふたの角度センサーが応答しなくなりました。再接続されるとSoftfoldは自動的にオンに戻ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "덮개 각도 센서가 응답하지 않습니다. 다시 연결되면 Softfold가 자동으로 다시 켜집니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De klepsensor reageert niet meer. Softfold gaat weer aan zodra de sensor opnieuw verbonden is."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czujnik pokrywy przestał odpowiadać. Softfold włączy się ponownie, gdy tylko czujnik się połączy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O sensor da tampa parou de responder. O Softfold será reativado assim que ele se reconectar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Датчик крышки перестал отвечать. Softfold снова включится, как только он переподключится."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapak sensörü yanıt vermiyor. Softfold, sensör yeniden bağlanır bağlanmaz tekrar açılır."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cảm biến nắp đã ngừng phản hồi. Softfold sẽ tự bật lại ngay khi kết nối lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "屏幕开合角度传感器停止响应。重新连接后 Softfold 会自动重新开启。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "螢幕開合角度感測器沒有回應。重新連接後 Softfold 會自動重新開啟。"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Locksensorn slutade svara. Softfold slås på igen så snart den återansluts."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokksensoren sluttet å svare. Softfold slår seg på igjen så snart den kobles til på nytt."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Lågsensoren holdt op med at svare. Softfold slås til igen, så snart den genforbindes."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kannen kulma-anturi lakkasi vastaamasta. Softfold aktivoituu heti, kun yhteys palautuu."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Датчик кришки перестав відповідати. Softfold увімкнеться знову, щойно зв'язок відновиться."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Snímač víka přestal reagovat. Softfold se znovu zapne, jakmile se obnoví připojení."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Senzorul capacului a încetat să mai răspundă. Softfold se activează din nou imediat ce se reconectează."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A fedélérzékelő nem válaszol. A Softfold azonnal visszakapcsol, amint újra csatlakozik."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο αισθητήρας καπακιού σταμάτησε να αποκρίνεται. Το Softfold θα ενεργοποιηθεί ξανά μόλις επανασυνδεθεί."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लिड सेंसर ने जवाब देना बंद कर दिया। पुनः कनेक्ट होते ही Softfold वापस चालू हो जाएगा।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "লিড সেন্সর সাড়া দেওয়া বন্ধ করেছে। পুনরায় সংযুক্ত হওয়ার সাথে সাথে Softfold আবার চালু হবে।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "மூடி உணரி பதிலளிப்பதை நிறுத்தியது. மீண்டும் இணைந்தவுடன் Softfold தானாகவே இயங்கும்."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "لِڈ سینسر نے جواب دینا بند کر دیا۔ دوبارہ منسلک ہوتے ہی Softfold واپس آن ہو جائے گا۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "حسگر زاویه صفحه پاسخ نمی‌دهد. به محض اتصال مجدد، Softfold دوباره فعال می‌شود."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "חיישן המכסה הפסיק להגיב. Softfold תופעל מחדש ברגע שהוא יתחבר שוב."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เซ็นเซอร์วัดมุมฝาพับหยุดตอบสนอง Softfold จะเปิดทำงานอีกครั้งทันทีที่เชื่อมต่อใหม่"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sensor sudut tutup berhenti merespons. Softfold akan menyala kembali segera setelah terhubung lagi."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Penderia penutup berhenti bertindak balas. Softfold akan dihidupkan semula sebaik sahaja ia disambung semula."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Huminto sa pagtugon ang sensor ng takip. Muling bubukas ang Softfold sa sandaling muling kumonekta ito."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Kihisi cha mfuniko kimeacha kujibu. Softfold itawashwa tena mara tu kitakapounganishwa tena."
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Die dekselsensor het opgehou reageer. Softfold skakel weer aan sodra dit herkoppel."
          }
        },
        "la": {
          "stringUnit": {
            "state": "translated",
            "value": "Sensor coopertorii respondere desiit. Softfold statim redibit ubi iterum conexum erit."
          }
        },
        "eo": {
          "stringUnit": {
            "state": "translated",
            "value": "La kovrilsentilo ĉesis respondi. Softfold reŝaltiĝos tuj kiam ĝi rekonektiĝos."
          }
        }
      }
    },
    "This Mac doesn't appear to have a lid angle sensor, so Softfold can't follow the lid.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يبدو أن جهاز Mac هذا لا يحتوي على مستشعر لزاوية الغطاء، لذا لا يستطيع Softfold تتبُّع الغطاء."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Mac scheint keinen Deckelwinkelsensor zu haben, daher kann Softfold dem Deckel nicht folgen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Parece que este Mac no tiene sensor de ángulo de la tapa, así que Softfold no puede seguirla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce Mac ne semble pas avoir de capteur d’angle d’écran, Softfold ne peut donc pas suivre l’écran."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sembra che questo Mac non abbia un sensore dell’angolo dello schermo, quindi Softfold non può seguirlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このMacにはふたの角度センサーがないようです。そのため、Softfoldはふたの動きに追従できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Mac에는 덮개 각도 센서가 없는 것 같습니다. 따라서 Softfold가 덮개를 따라갈 수 없습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze Mac lijkt geen klephoeksensor te hebben, dus Softfold kan de klep niet volgen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten Mac prawdopodobnie nie ma czujnika kąta pokrywy, więc Softfold nie może za nią podążać."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este Mac parece não ter um sensor de ângulo da tampa, então o Softfold não consegue acompanhá-la."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Похоже, на этом Mac нет датчика угла крышки, поэтому Softfold не может следовать за ней."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu Mac’te kapak açısı sensörü yok gibi görünüyor, bu yüzden Softfold kapağı takip edemiyor."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Máy Mac này có vẻ không có cảm biến góc nắp, nên Softfold không thể theo nắp máy."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台 Mac 似乎没有屏幕开合角度传感器，因此 Softfold 无法跟随屏幕开合。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這部 Mac 似乎沒有螢幕開合角度感測器，因此 Softfold 無法跟隨螢幕開合。"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Denna Mac verkar sakna lockvinkelsensor, så Softfold kan inte följa locket."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne Mac-en ser ikke ut til å ha en sensor for lokkvinkel, så Softfold kan ikke følge lokket."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne Mac ser ikke ud til at have en sensor til lågvinkel, så Softfold kan ikke følge låget."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tässä Macissa ei näytä olevan kannen kulma-anturia, joten Softfold ei voi seurata kantta."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Схоже, цей Mac не має датчика кута кришки, тому Softfold не може слідувати за нею."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tento Mac zřejmě nemá snímač úhlu víka, takže Softfold nemůže víko sledovat."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Acest Mac nu pare să aibă un senzor de unghi al capacului, astfel încât Softfold nu poate urmări capacul."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Úgy tűnik, ez a Mac nem rendelkezik szögérzékelővel, így a Softfold nem tudja követni a fedelet."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτό το Mac δεν φαίνεται να διαθέτει αισθητήρα γωνίας καπακιού, επομένως το Softfold δεν μπορεί να ακολουθήσει το καπάκι."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऐसा प्रतीत होता है कि इस Mac में लिड एंगल सेंसर नहीं है, इसलिए Softfold लिड का अनुसरण नहीं कर सकता।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই Mac-এ লিড অ্যাঙ্গেল সেন্সর নেই বলে মনে হচ্ছে, তাই Softfold লিড অনুসরণ করতে পারছে না।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்த Mac-ல் மூடி கோண உணரி இல்லை எனத் தெரிகிறது, எனவே Softfold மூடியைப் பின்தொடர முடியாது."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ایسا لگتا ہے کہ اس Mac میں لِڈ اینگل سینسر نہیں ہے، اس لیے Softfold لِڈ کی پیروی نہیں کر سکتا۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "به نظر می‌رسد این مک فاقد حسگر زاویه صفحه است، بنابراین Softfold نمی‌تواند حرکت صفحه را دنبال کند."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "נראה שב-Mac זה אין חיישן זווית מכסה, ולכן Softfold אינה יכולה לעקוב אחר המכסה."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ดูเหมือน Mac เครื่องนี้ไม่มีเซ็นเซอร์วัดมุมฝาพับ Softfold จึงไม่สามารถทำงานตามฝาพับได้"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac ini sepertinya tidak memiliki sensor sudut tutup, sehingga Softfold tidak dapat mengikuti gerakan tutup."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac ini nampaknya tidak mempunyai penderia sudut penutup, jadi Softfold tidak dapat mengikut penutup."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Mukhang walang lid angle sensor ang Mac na ito, kaya hindi masusundan ng Softfold ang takip."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac hii haionekani kuwa na kihisi cha pembe ya mfuniko, kwa hivyo Softfold haiwezi kufuata mfuniko."
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Hierdie Mac het blykbaar nie 'n dekselhoeksensor nie, so Softfold kan nie die deksel volg nie."
          }
        },
        "la": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoc Mac sensore anguli coopertorii carere videtur, quare Softfold motum sequi non potest."
          }
        },
        "eo": {
          "stringUnit": {
            "state": "translated",
            "value": "Ĉi tiu Mac ŝajne ne havas kovrilangulan sentilon, tial Softfold ne povas sekvi la kovrilon."
          }
        }
      }
    },
