    "Softfold reads your display only to draw the fold. Frames stay in memory on your Mac." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يقرأ Softfold شاشتك فقط لرسم الطيّة. تبقى الإطارات في ذاكرة جهاز Mac لديك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Softfold liest deinen Bildschirm nur, um die Faltung zu zeichnen. Die Bilder bleiben im Arbeitsspeicher deines Mac."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Softfold lee tu pantalla solo para dibujar el pliegue. Las imágenes se quedan en la memoria de tu Mac."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Softfold lit votre écran uniquement pour dessiner le pli. Les images restent dans la mémoire de votre Mac."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Softfold legge lo schermo solo per disegnare la piega. I fotogrammi restano nella memoria del Mac."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Softfoldが画面を読み取るのは折り目を描くためだけです。フレームはMacのメモリ内にのみ保持されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Softfold는 접힘 효과를 그리기 위해서만 화면을 읽습니다. 프레임은 Mac의 메모리에만 머무릅니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Softfold leest je scherm alleen om de vouw te tekenen. De beelden blijven in het geheugen van je Mac."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Softfold odczytuje ekran tylko po to, by narysować zagięcie. Klatki pozostają w pamięci Maca."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Softfold lê sua tela só para desenhar a dobra. Os quadros ficam na memória do seu Mac."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Softfold считывает экран только для отрисовки сгиба. Кадры остаются в памяти вашего Mac."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Softfold ekranınızı yalnızca katlamayı çizmek için okur. Kareler Mac’inizin belleğinde kalır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Softfold chỉ đọc màn hình để vẽ nếp gập. Các khung hình chỉ nằm trong bộ nhớ của máy Mac."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Softfold 读取屏幕内容只为绘制折叠效果，画面只保存在你的 Mac 内存中。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Softfold 讀取螢幕內容只為繪製摺疊效果，畫面只保存在你的 Mac 記憶體中。"
          }
        }
      }
    },
