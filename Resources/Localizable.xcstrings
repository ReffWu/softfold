    "Starts at 100°. Set your comfortable open position once, and Softfold remembers it." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يبدأ عند 100°. اضبط وضع الفتح المريح لك مرة واحدة، وسيتذكره Softfold."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Standard ist 100°. Lege einmal deine bevorzugte Öffnungsposition fest, Softfold merkt sie sich."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Empieza en 100°. Ajusta una vez tu posición de apertura cómoda y Softfold la recordará."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "100° par défaut. Réglez une fois votre position d’ouverture préférée, Softfold s’en souviendra."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parte da 100°. Imposta una volta la tua posizione di apertura preferita e Softfold la ricorderà."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "初期値は100°です。見やすい開き具合を一度設定すると、Softfoldが記憶します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기본값은 100°입니다. 편한 열림 위치를 한 번 설정하면 Softfold가 기억합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Begint bij 100°. Stel één keer je favoriete openstand in en Softfold onthoudt die."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Domyślnie 100°. Ustaw raz wygodną pozycję otwarcia, a Softfold ją zapamięta."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Começa em 100°. Defina uma vez sua posição de abertura preferida, e o Softfold vai lembrar dela."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "По умолчанию 100°. Задайте удобное положение открытия один раз, и Softfold его запомнит."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "100° ile başlar. Rahat açık konumunuzu bir kez ayarlayın, Softfold onu hatırlar."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mặc định là 100°. Đặt vị trí mở thoải mái của bạn một lần, Softfold sẽ ghi nhớ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "默认 100°。设定一次你习惯的打开角度，Softfold 会记住它。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "預設為 100°。設定一次你習慣的開啟角度，Softfold 會記住它。"
          }
        }
      }
    },
