          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Softfold imewashwa lakini bado haijaanza kufanya kazi."
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Softfold is aan, maar loop nog nie."
          }
        },
        "la": {
