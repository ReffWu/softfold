    "It’s free and open source. A star on GitHub helps more people find it.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إنه مجاني ومفتوح المصدر. نجمة على GitHub تساعد المزيد من الناس في العثور عليه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es ist kostenlos und Open Source. Ein Stern auf GitHub hilft mehr Menschen, es zu finden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Es gratis y de código abierto. Una estrella en GitHub ayuda a que más personas lo encuentren."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C’est gratuit et open source. Une étoile sur GitHub aide davantage de personnes à le découvrir."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È gratuito e open source. Una stella su GitHub aiuta più persone a trovarlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "無料のオープンソースです。GitHub でスターを付けると、より多くの人が見つけやすくなります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "무료 오픈 소스입니다. GitHub에서 별표를 주시면 더 많은 사람이 찾을 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het is gratis en open source. Een ster op GitHub helpt meer mensen het te vinden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jest darmowy i otwartoźródłowy. Gwiazdka na GitHubie pomaga innym go znaleźć."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "É gratuito e de código aberto. Uma estrela no GitHub ajuda mais pessoas a encontrá-lo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Он бесплатный и с открытым исходным кодом. Звезда на GitHub поможет другим его найти."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ücretsiz ve açık kaynaklı. GitHub’da bir yıldız, daha çok kişinin onu bulmasına yardımcı olur."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ứng dụng miễn phí và mã nguồn mở. Một ngôi sao trên GitHub giúp nhiều người tìm thấy nó hơn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它免费且开源。在 GitHub 上点个星，能让更多人发现它。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "它免費且開源。在 GitHub 上給個星，能讓更多人發現它。"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det är gratis och med öppen källkod. En stjärna på GitHub hjälper fler att hitta det."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Det er gratis og åpen kildekode. En stjerne på GitHub hjelper flere med å finne det."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Det er gratis og open source. En stjerne på GitHub hjælper flere med at finde det."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Se on ilmainen ja avointa lähdekoodia. Tähti GitHubissa auttaa useampia löytämään sen."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це безкоштовно та з відкритим кодом. Зірка на GitHub допоможе більшій кількості людей знайти його."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Je zdarma a s otevřeným zdrojovým kódem. Hvězdička na GitHubu pomůže ostatním aplikaci objevit."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Este gratuit și open source. O stea pe GitHub ajută mai mulți oameni să îl descopere."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingyenes és nyílt forráskódú. Egy csillag a GitHubon segít másoknak rátalálni."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Είναι δωρεάν και ανοιχτού κώδικα. Ένα αστέρι στο GitHub βοηθά περισσότερους να το ανακαλύψουν."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह मुफ़्त और ओपन-सोर्स है। GitHub पर एक स्टार और लोगों को इसे खोजने में मदद करता है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এটি বিনামূল্যে এবং ওপেন সোর্স। GitHub-এ একটি স্টার আরও মানুষকে এটি খুঁজে পেতে সাহায্য করে।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இது இலவசம் மற்றும் திறந்த மூலமானது. GitHub-ல் ஒரு நட்சத்திரம் மேலும் பலர் இதைக் கண்டறிய உதவும்."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ مفت اور اوپن سورس ہے۔ GitHub پر ایک اسٹار مزید لوگوں کو اسے تلاش کرنے میں مدد کرتا ہے۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "رایگان و متن‌باز است. یک ستاره در GitHub به دیگران کمک می‌کند آن را پیدا کنند."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "היישום חינמי ובקוד פתוח. כוכב ב-GitHub עוזר לאנשים נוספים לגלות אותו."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แอปนี้ฟรีและเป็นโอเพนซอร์ส การให้ดาวบน GitHub จะช่วยให้ผู้คนค้นพบแอปนี้มากขึ้น"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikasi ini gratis dan sumber terbuka. Sebuah bintang di GitHub membantu lebih banyak orang menemukannya."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ia percuma dan sumber terbuka. Bintang di GitHub membantu lebih ramai orang menemuinya."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ito ay libre at open source. Ang star sa GitHub ay nakakatulong sa mas maraming tao na mahanap ito."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Ni ya bure na chanzo wazi. Nyota kwenye GitHub husaidia watu wengi zaidi kuipata."
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit is gratis en oopbron. 'n Ster op GitHub help meer mense om dit te vind."
          }
        },
        "la": {
          "stringUnit": {
            "state": "translated",
            "value": "Gratis et aperto codice est. Stella in GitHub plures adiuvat ut inveniant."
          }
        },
        "eo": {
          "stringUnit": {
            "state": "translated",
            "value": "Ĝi estas senpaga kaj malfermfonta. Stelo ĉe GitHub helpas pli da homoj trovi ĝin."
          }
        }
      }
    },
