    "The desktop renderer is missing. Rebuild the app.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مكوّن عرض سطح المكتب مفقود. أعد بناء التطبيق."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Schreibtisch-Renderer fehlt. Erstelle die App neu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Falta el renderizador del escritorio. Vuelve a compilar la app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le moteur de rendu du bureau est introuvable. Recompilez l’app."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il renderer della scrivania non è presente. Ricompila l’app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デスクトップの描画コンポーネントが見つかりません。アプリをビルドし直してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "데스크탑 렌더러가 없습니다. 앱을 다시 빌드하십시오."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De bureaubladrenderer ontbreekt. Bouw de app opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brakuje renderera biurka. Zbuduj aplikację ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O renderizador da mesa está faltando. Compile o app novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Модуль отрисовки рабочего стола отсутствует. Пересоберите приложение."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Masaüstü görüntüleyici eksik. Uygulamayı yeniden derleyin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thiếu bộ hiển thị màn hình nền. Hãy dựng lại ứng dụng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "缺少桌面渲染组件。请重新构建应用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "缺少桌面繪製元件。請重新建置 App。"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skrivbordsrenderaren saknas. Bygg om appen."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Skrivebordsgjengiveren mangler. Bygg appen på nytt."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Skrivebordsgengiveren mangler. Byg appen igen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Työpöydän renderöijä puuttuu. Rakenna sovellus uudelleen."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Візуалізатор робочого столу відсутній. Перезберіть програму."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Chybí vykreslovač plochy. Sestavte aplikaci znovu."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Motorul de randare lipsește. Reconstruiți aplicația."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az íróasztal-megjelenítő hiányzik. Építsd újra az alkalmazást."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το στοιχείο απόδοσης λείπει. Ανακατασκευάστε την εφαρμογή."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "डेस्कटॉप रेंडरर अनुपलब्ध है। ऐप को फिर से बनाएं।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ডেস্কটপ রেন্ডারার অনুপস্থিত। অ্যাপটি পুনরায় তৈরি করুন।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "டெஸ்க்டாப் ரெண்டரர் இல்லை. செயலியை மீண்டும் உருவாக்கவும்."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ڈیسک ٹاپ رینڈرر غائب ہے۔ ایپ کو دوبارہ بنائیں۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "رندرساز میزکار مفقود است. برنامه را دوباره بسازید."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מנוע הרינדור של שולחן העבודה חסר. בנה מחדש את היישום."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตัวแสดงผลเดสก์ท็อปหายไป โปรดสร้างแอปใหม่อีกครั้ง"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Penyaji desktop hilang. Bangun ulang aplikasi."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pemapar desktop tiada. Bina semula app."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Nawawala ang desktop renderer. Muling buuin ang app."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Kitoa dawati hakipo. Unda upya programu."
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Die werkskerm-weergeeier ontbreek. Herbou die toepassing."
          }
        },
        "la": {
          "stringUnit": {
            "state": "translated",
            "value": "Apparatus scrinii reddendi deest. App rursus construe."
          }
        },
        "eo": {
          "stringUnit": {
            "state": "translated",
            "value": "La labortabla bildigilo mankas. Rekonstruu la apon."
          }
        }
      }
    },
