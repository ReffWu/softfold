{
  "sourceLanguage": "en",
  "strings": {
    "Allow Softfold in Screen Recording settings, then quit and reopen it.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسمح لـ Softfold في إعدادات تسجيل الشاشة، ثم أنهِه وافتحه من جديد."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlaube Softfold in den Einstellungen für Bildschirmaufnahme, beende die App und öffne sie erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite Softfold en la configuración de Grabación de pantalla y luego ciérralo y vuelve a abrirlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez Softfold dans les réglages Enregistrement de l’écran, puis quittez-le et rouvrez-le."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consenti Softfold nelle impostazioni di Registrazione schermo, poi chiudila e riaprila."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「画面収録」設定でSoftfoldを許可してから、Softfoldを終了して開き直してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "'화면 기록' 설정에서 Softfold를 허용한 다음, 종료하고 다시 여십시오."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sta Softfold toe in de instellingen voor schermopname, stop de app en open hem opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozwól na Softfold w ustawieniach nagrywania ekranu, a potem zakończ i otwórz aplikację ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permita o Softfold nos ajustes de Gravação de Tela e depois encerre e reabra o app."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешите Softfold в настройках записи экрана, затем завершите и снова откройте его."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekran Kaydı ayarlarında Softfold’e izin verin, ardından uygulamadan çıkıp yeniden açın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cho phép Softfold trong cài đặt Ghi màn hình, sau đó thoát và mở lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在“屏幕录制”设置中允许 Softfold，然后退出并重新打开。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請在「螢幕錄製」設定中允許 Softfold，然後結束並重新開啟。"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tillåt Softfold i inställningarna för Skärminspelning, avsluta sedan och öppna det igen."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tillat Softfold i innstillingene for Skjermopptak, avslutt deretter og åpne det på nytt."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tillad Softfold i indstillingerne for Skærmoptagelse, slut derefter og åbn det igen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Salli Softfold Näytön tallennus -asetuksissa, sulje sovellus ja avaa se uudelleen."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дозвольте Softfold у параметрах запису екрана, потім завершіть і відкрийте його знову."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Povolte Softfold v nastavení Záznamu obrazovky, poté aplikaci ukončete a znovu otevřete."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Permiteți accesul Softfold în configurările Înregistrare ecran, apoi închideți și redeschideți aplicația."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Engedélyezd a Softfoldot a Képernyőfelvétel beállításaiban, majd lépj ki, és nyisd meg újra."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επιτρέψτε το Softfold στις ρυθμίσεις Εγγραφής οθόνης, μετά κλείστε το και ανοίξτε το ξανά."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्क्रीन रिकॉर्डिंग सेटिंग्स में Softfold की अनुमति दें, फिर इसे छोड़ें और पुनः खोलें।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "স্ক্রিন রেকর্ডিং সেটিংসে Softfold-কে অনুমতি দিন, তারপর বন্ধ করে পুনরায় খুলুন।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "திரைப்பதிவு அமைப்புகளில் Softfold-ஐ அனுமதிக்கவும், பின் வெளியேறி மீண்டும் திறக்கவும்."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اسکرین ریکارڈنگ کی ترتیبات میں Softfold کی اجازت دیں، پھر بند کر کے دوبارہ کھولیں۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "به Softfold در تنظیمات ضبط صفحه اجازه دهید، سپس خارج شده و دوباره آن را باز کنید."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אפשר את Softfold בהגדרות הקלטת מסך, לאחר מכן צא ופתח אותה מחדש."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อนุญาตให้ Softfold ในการตั้งค่าการบันทึกหน้าจอ จากนั้นออกจากแอปแล้วเปิดใหม่อีกครั้ง"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Izinkan Softfold di pengaturan Perekaman Layar, lalu keluar dan buka kembali."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Benarkan Softfold dalam seting Rakaman Skrin, kemudian keluar dan buka semula."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Payagan ang Softfold sa mga setting ng Pag-record ng Screen, pagkatapos ay lumabas at buksan itong muli."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Ruhusu Softfold katika mipangilio ya Kurekodi Skrini, kisha funga na ufungue tena."
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Laat Softfold toe in Skermopname-instellings, sluit dit dan af en maak dit weer oop."
          }
        },
        "la": {
          "stringUnit": {
            "state": "translated",
            "value": "Permitte Softfold in optione Capturae Putealis, deinde claude et rursus aperi."
          }
        },
        "eo": {
          "stringUnit": {
            "state": "translated",
            "value": "Permesu Softfold en la agordoj de Ekrana Registrado, poste fermu kaj remalfermu ĝin."
          }
        }
      }
    },
