    "Allow Softfold in Login Items to finish." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اسمح لـ Softfold في عناصر تسجيل الدخول لإكمال الإعداد."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erlaube Softfold in den Anmeldeobjekten, um den Vorgang abzuschließen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite Softfold en los ítems de inicio de sesión para terminar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autorisez Softfold dans les éléments de connexion pour terminer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consenti Softfold in Elementi login per completare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "設定を完了するには、ログイン項目でSoftfoldを許可してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "설정을 완료하려면 로그인 항목에서 Softfold를 허용하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sta Softfold toe bij inlogonderdelen om af te ronden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pozwól na Softfold w rzeczach otwieranych podczas logowania, aby dokończyć."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permita o Softfold em Itens de Início para concluir."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Разрешите Softfold в объектах входа, чтобы завершить."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tamamlamak için Giriş Öğeleri’nde Softfold’e izin verin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cho phép Softfold trong Mục đăng nhập để hoàn tất."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请在登录项中允许 Softfold 以完成设置。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請在登入項目中允許 Softfold 以完成設定。"
          }
        }
      }
    },
    "Allow Softfold in Screen Recording settings, then quit and reopen it." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اسمح لـ Softfold في إعدادات تسجيل الشاشة، ثم أنهِه وافتحه من جديد."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erlaube Softfold in den Einstellungen für Bildschirmaufnahme, beende die App und öffne sie erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite Softfold en la configuración de Grabación de pantalla y luego ciérralo y vuelve a abrirlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autorisez Softfold dans les réglages Enregistrement de l’écran, puis quittez-le et rouvrez-le."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consenti Softfold nelle impostazioni di Registrazione schermo, poi chiudila e riaprila."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「画面収録」設定でSoftfoldを許可してから、Softfoldを終了して開き直してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'화면 기록' 설정에서 Softfold를 허용한 다음, 종료하고 다시 여십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sta Softfold toe in de instellingen voor schermopname, stop de app en open hem opnieuw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pozwól na Softfold w ustawieniach nagrywania ekranu, a potem zakończ i otwórz aplikację ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permita o Softfold nos ajustes de Gravação de Tela e depois encerre e reabra o app."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Разрешите Softfold в настройках записи экрана, затем завершите и снова откройте его."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ekran Kaydı ayarlarında Softfold’e izin verin, ardından uygulamadan çıkıp yeniden açın."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cho phép Softfold trong cài đặt Ghi màn hình, sau đó thoát và mở lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请在“屏幕录制”设置中允许 Softfold，然后退出并重新打开。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請在「螢幕錄製」設定中允許 Softfold，然後結束並重新開啟。"
          }
        }
      }
    },
