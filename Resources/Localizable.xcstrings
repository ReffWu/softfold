    "Could not allocate the desktop texture.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر تخصيص نسيج سطح المكتب."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Schreibtischtextur konnte nicht angelegt werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo asignar la textura del escritorio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d’allouer la texture du bureau."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile allocare la texture della scrivania."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デスクトップのテクスチャを確保できませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "데스크탑 텍스처를 할당할 수 없습니다."
          }
        },
