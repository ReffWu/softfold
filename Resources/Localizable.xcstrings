    "Counts active Macs once a day. Nothing from your screen is sent.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحصي أجهزة Mac النشطة مرة واحدة يوميًا. لا يُرسل أي شيء من شاشتك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zählt aktive Macs einmal täglich. Nichts von deinem Bildschirm wird gesendet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuenta los Mac activos una vez al día. No se envía nada de tu pantalla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Compte les Mac actifs une fois par jour. Rien de votre écran n’est envoyé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Conta i Mac attivi una volta al giorno. Nulla del tuo schermo viene inviato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1日に1回、使用中の Mac の台数を数えます。画面の内容は送信されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "하루에 한 번 사용 중인 Mac 수를 셉니다. 화면의 내용은 전송되지 않습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Telt actieve Macs één keer per dag. Er wordt niets van je scherm verstuurd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Liczy aktywne Maki raz dziennie. Nic z Twojego ekranu nie jest wysyłane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conta os Macs ativos uma vez por dia. Nada da sua tela é enviado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Раз в день учитывает активные Mac. Ничего с вашего экрана не отправляется."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Etkin Mac’leri günde bir kez sayar. Ekranınızdan hiçbir şey gönderilmez."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đếm số máy Mac đang hoạt động mỗi ngày một lần. Không gửi bất cứ nội dung nào trên màn hình."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每天统计一次正在使用的 Mac 数量，不会发送屏幕上的任何内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每天統計一次正在使用的 Mac 數量，不會傳送螢幕上的任何內容。"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Räknar aktiva Mac-datorer en gång om dagen. Inget från din skärm skickas."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Teller aktive Mac-er en gang om dagen. Ingenting fra skjermen din sendes."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tæller aktive Mac-computere en gang om dagen. Intet fra din skærm sendes."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Laskee aktiiviset Macit kerran päivässä. Näytöltäsi ei lähetetä mitään."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Рахує активні Mac один раз на день. Нічого з вашого екрана не надсилається."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Počítá aktivní Macy jednou denně. Z obrazovky se nic neodesílá."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Numără Mac-urile active o dată pe zi. Nimic de pe ecran nu este trimis."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Naponta egyszer számolja az aktív Maceket. A képernyődről semmi sem kerül elküldésre."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Καταμετρά τα ενεργά Mac μία φορά την ημέρα. Δεν αποστέλλεται τίποτα από την οθόνη σας."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दिन में एक बार सक्रिय Mac गिनता है। आपकी स्क्रीन से कुछ भी नहीं भेजा जाता है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "দিনে একবার সক্রিয় Mac গণনা করে। আপনার স্ক্রিন থেকে কিছুই পাঠানো হয় না।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஒரு நாளைக்கு ஒரு முறை செயலில் உள்ள Mac-களைக் கணக்கிடுகிறது. உங்கள் திரையிலிருந்து எதுவும் அனுப்பப்படாது."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "دن میں ایک بار فعال Mac گنتا ہے۔ آپ کی اسکرین سے کچھ بھی نہیں بھیجا جاتا۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "مک‌های فعال را روزی یک بار می‌شمارد. هیچ چیز از صفحه شما ارسال نمی‌شود."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "סופר מחשבי Mac פעילים פעם ביום. שום דבר מהמסך שלך לא נשלח."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "นับจำนวน Mac ที่ใช้งานวันละครั้ง ไม่มีการส่งข้อมูลใดๆ จากหน้าจอของคุณ"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menghitung Mac yang aktif sekali sehari. Tidak ada apa pun dari layar Anda yang dikirim."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengira Mac yang aktif sekali sehari. Tiada apa-apa dari skrin anda dihantar."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Bumabilang ng mga aktibong Mac minsan sa isang araw. Walang ipinapadala mula sa iyong screen."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Huhesabu Mac zinazotumika mara moja kwa siku. Hakuna chochote kutoka kwenye skrini yako kinachotumwa."
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Tel aktiewe Macs een keer per dag. Niks van jou skerm word gestuur nie."
          }
        },
        "la": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac actuosos semel in die numerat. Nihil de scrinio tuo mittitur."
          }
        },
        "eo": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalkulas aktivajn Mac-komputilojn unufoje tage. Nenio de via ekrano estas sendata."
          }
        }
      }
    },
