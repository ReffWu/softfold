            "state": "translated",
            "value": "Softfold er på, men kjører ikke ennå."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Softfold er slået til, men kører ikke endnu."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Softfold on päällä, mutta ei vielä käynnissä."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Softfold увімкнено, але він ще не працює."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Softfold je zapnutý, ale zatím neběží."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Softfold este pornit, dar nu rulează încă."
          }
        },
        "hu": {
