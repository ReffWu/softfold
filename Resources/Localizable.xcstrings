            "state" : "translated",
            "value" : "Flou selon la distance"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sfocatura in base alla distanza"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "距離に応じてぼかす"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "거리에 따라 흐리게"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vervagen op afstand"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rozmycie wg odległości"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desfoque pela distância"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Размытие по расстоянию"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uzaklığa göre bulanıklaştır"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Làm mờ theo khoảng cách"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按距离模糊"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "依距離模糊"
          }
        }
      }
    },
    "Blur grows with distance from the open screen, so the hinge edge stays sharp." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يزداد التمويه كلما ابتعدت عن الشاشة المفتوحة، وتبقى الحافة القريبة من المفصل واضحة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Unschärfe wächst mit dem Abstand zum geöffneten Bildschirm, am Scharnier bleibt alles scharf."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El desenfoque crece con la distancia a la pantalla abierta, así el borde de la bisagra se mantiene nítido."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le flou augmente avec la distance à l’écran ouvert, le bord de la charnière reste net."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La sfocatura cresce con la distanza dallo schermo aperto, così il bordo della cerniera resta nitido."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "開いたときの画面から離れるほど強くぼかし、ヒンジ付近はくっきり保ちます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "열려 있던 화면에서 멀어질수록 흐려지고, 힌지 가까이는 선명하게 유지됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De vervaging neemt toe met de afstand tot het geopende scherm, zodat de rand bij het scharnier scherp blijft."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rozmycie rośnie z odległością od otwartego ekranu, a krawędź przy zawiasie pozostaje ostra."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O desfoque aumenta com a distância da tela aberta, e a borda da dobradiça fica nítida."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Размытие растёт с удалением от открытого экрана, а край у шарнира остаётся чётким."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bulanıklık açık ekrandan uzaklaştıkça artar, menteşe kenarı net kalır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Càng xa màn hình lúc mở thì càng mờ, mép gần bản lề vẫn giữ rõ nét."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "离打开时的屏幕越远越模糊，靠近转轴处保持清晰。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "離打開時的螢幕越遠越模糊，靠近轉軸處保持清晰。"
          }
        }
      }
    },
