    "Softfold reads your display only to draw the fold. Frames stay in memory on your Mac.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يقرأ Softfold شاشتك فقط لرسم الطيّة. تبقى الإطارات في ذاكرة جهاز Mac لديك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Softfold liest deinen Bildschirm nur, um die Faltung zu zeichnen. Die Bilder bleiben im Arbeitsspeicher deines Mac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Softfold lee tu pantalla solo para dibujar el pliegue. Las imágenes se quedan en la memoria de tu Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Softfold lit votre écran uniquement pour dessiner le pli. Les images restent dans la mémoire de votre Mac."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Softfold legge lo schermo solo per disegnare la piega. I fotogrammi restano nella memoria del Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Softfoldが画面を読み取るのは折り目を描くためだけです。フレームはMacのメモリ内にのみ保持されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Softfold는 접힘 효과를 그리기 위해서만 화면을 읽습니다. 프레임은 Mac의 메모리에만 머무릅니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Softfold leest je scherm alleen om de vouw te tekenen. De beelden blijven in het geheugen van je Mac."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Softfold odczytuje ekran tylko po to, by narysować zagięcie. Klatki pozostają w pamięci Maca."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Softfold lê sua tela só para desenhar a dobra. Os quadros ficam na memória do seu Mac."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Softfold считывает экран только для отрисовки сгиба. Кадры остаются в памяти вашего Mac."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Softfold ekranınızı yalnızca katlamayı çizmek için okur. Kareler Mac’inizin belleğinde kalır."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Softfold chỉ đọc màn hình để vẽ nếp gập. Các khung hình chỉ nằm trong bộ nhớ của máy Mac."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Softfold 读取屏幕内容只为绘制折叠效果，画面只保存在你的 Mac 内存中。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Softfold 讀取螢幕內容只為繪製摺疊效果，畫面只保存在你的 Mac 記憶體中。"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Softfold läser bara av din skärm för att rita vikningen. Bildrutor stannar i minnet på din Mac."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Softfold leser bare skjermen din for å tegne folden. Bildene blir værende i minnet på Mac-en din."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Softfold læser kun din skærm for at tegne folden. Billederne bliver i hukommelsen på din Mac."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Softfold lukee näyttöäsi vain taitoksen piirtämistä varten. Kuvat säilyvät Macisi muistissa."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Softfold зчитує дисплей лише для малювання згину. Кадри залишаються в пам'яті вашого Mac."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Softfold snímá obrazovku pouze k vykreslení ohybu. Snímky zůstávají v paměti vašeho Macu."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Softfold citește ecranul doar pentru a desena plierea. Cadrele rămân în memoria Mac-ului dvs."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Softfold csak a hajtás rajzolásához olvassa a képernyőt. A képkockák a Mac memóriájában maradnak."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Softfold διαβάζει την οθόνη σας μόνο για τη σχεδίαση της πτυχής. Τα καρέ παραμένουν στη μνήμη του Mac σας."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Softfold केवल फ़ोल्ड बनाने के लिए आपका डिस्प्ले पढ़ता है। फ़्रेम आपके Mac की मेमोरी में रहते हैं।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Softfold শুধুমাত্র ভাঁজ আঁকার জন্য আপনার ডিসপ্লে পড়ে। ফ্রেমগুলি আপনার Mac-এর মেমরিতে থাকে।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Softfold மடிப்பை வரைய மட்டுமே உங்கள் திரையைப் படிக்கிறது. பிரேம்கள் உங்கள் Mac நினைவகத்திலேயே இருக்கும்."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Softfold صرف فولڈ بنانے کے لیے آپ کی سکرین پڑھتا ہے۔ فریمز آپ کے Mac کی میموری میں رہتے ہیں۔"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "Softfold نمایشگر شما را فقط برای ترسیم تاخوردگی می‌خواند. فریم‌ها فقط در حافظه مک شما باقی می‌مانند."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "Softfold קוראת את הצג שלך רק כדי לצייר את הקיפול. הפריימים נשארים בזיכרון ה-Mac שלך."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Softfold อ่านหน้าจอเพื่อวาดรอยพับเท่านั้น เฟรมภาพจะคงอยู่ในหน่วยความจำ Mac ของคุณ"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Softfold membaca layar Anda hanya untuk menggambar lipatan. Bingkai gambar tetap berada di memori Mac Anda."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Softfold membaca paparan anda hanya untuk melukis lipatan. Bingkai kekal dalam memori Mac anda."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Binabasa lamang ng Softfold ang iyong display upang iguhit ang tiklop. Nananatili ang mga frame sa memorya ng iyong Mac."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Softfold husoma onyesho lako tu ili kuchora mkunjo. Fremu hubaki kwenye kumbukumbu ya Mac yako."
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Softfold lees jou skerm net om die vou te teken. Rame bly in die geheue van jou Mac."
          }
        },
        "la": {
